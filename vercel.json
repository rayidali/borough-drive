{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/(?:|index\\.html|legacy\\.html|seventh/?|seventh/[^/]+)$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "^/seventh/areas/assets/[a-f0-9]{64}\\.scn$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "application/octet-stream",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/seventh/areas/manifest-[a-f0-9]{64}\\.json$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "application/json",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/seventh/index\\.pck$",
      "headers": { "Content-Type": "application/octet-stream" },
      "continue": true
    },
    {
      "src": "^/seventh/index\\.wasm$",
      "headers": { "Content-Type": "application/wasm" },
      "continue": true
    },
    { "src": "^/$", "dest": "/seventh/index.html" },
    { "src": "^/index\\.html$", "dest": "/legacy.html" },
    { "handle": "filesystem" },
    {
      "src": "^/seventh/areas/.*$",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "Content-Type": "text/plain; charset=utf-8",
        "X-Content-Type-Options": "nosniff"
      }
    }
  ]
}
